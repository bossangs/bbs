Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:conf|log|tmp|tool|data|plugin)(?:/|$) - [F,L,NC]
RewriteRule ^install/(?!index\.php$) - [F,L,NC]
RewriteRule ^upload/.*\.(?:php[0-9]?|phtml|phar)$ - [F,L,NC]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(?:sql|log|ini|bak|conf|config|dist|example|lock)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)\.(?:sql|log|ini|bak|conf|config|dist|example|lock)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
